{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OutcomePilot Fusion optional execution record (untrusted, advisory)",
  "type": "object",
  "additionalProperties": false,
  "required": ["objective", "max_steps", "used_steps", "criteria", "evidence", "actions"],
  "properties": {
    "objective": {"type": "string", "minLength": 1},
    "max_steps": {"type": "integer", "minimum": 1},
    "used_steps": {"type": "integer", "minimum": 0},
    "cancelled": {"type": "boolean"},
    "unsafe": {"type": "boolean"},
    "useful_partial": {"type": "boolean"},
    "next_action_id": {"type": ["string", "null"]},
    "criteria": {
      "type": "array", "items": {
        "type": "object", "required": ["id", "required", "status", "evidence_ids"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "required": {"type": "boolean"},
          "status": {"enum": ["PASS", "FAIL", "UNVERIFIED", "NOT_RUN"]},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "evidence": {
      "type": "array", "items": {
        "type": "object", "required": ["id", "kind", "check_result", "source", "criterion_ids"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["SOURCE_CHECK", "FILE_CHECK", "DIRECT_TEST", "OBSERVED_EFFECT", "READ_BACK", "OTHER"]},
          "check_result": {"enum": ["PASS", "FAIL", "UNVERIFIED", "NOT_RUN"]},
          "source": {"type": "string", "minLength": 1},
          "criterion_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "notes": {"type": "string"}
        }
      }
    },
    "actions": {
      "type": "array", "items": {
        "type": "object", "required": ["id", "kind", "status", "target", "authorization", "receipt_evidence_ids", "postcondition_evidence_ids", "ambiguous", "reconciled"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["READ", "ANALYZE", "LOCAL_EDIT", "EXTERNAL_WRITE", "COMMITMENT"]},
          "status": {"enum": ["PLANNED", "DONE", "FAILED", "UNKNOWN", "SKIPPED"]},
          "target": {"type": "string", "minLength": 1},
          "authorization": {"enum": ["NOT_REQUIRED", "REQUIRED_PENDING", "CLAIMED_APPROVED", "HOST_CONFIRMED"]},
          "receipt_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "postcondition_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "ambiguous": {"type": "boolean"},
          "reconciled": {"type": "boolean"}
        }
      }
    }
  }
}
